{
  "name": "@smollm/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "tauri": "tauri",
    "tauri:fixture": "tauri dev --config src-tauri/tauri.dev-fixture.conf.json",
    "tauri:settings": "tauri dev --config src-tauri/tauri.dev-settings.conf.json",
    "tauri:chat": "tauri dev --config src-tauri/tauri.dev-chat.conf.json",
    "tauri:weights": "tauri dev --config src-tauri/tauri.dev-weights.conf.json",
    "tauri:checkpoints": "tauri dev --config src-tauri/tauri.dev-checkpoints.conf.json",
    "tauri:restart": "tauri dev --config src-tauri/tauri.dev-restart.conf.json",
    "tauri:forget": "tauri dev --config src-tauri/tauri.dev-forget.conf.json",
    "tauri:stop": "tauri dev --config src-tauri/tauri.dev-stop.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "@eslint/js": "^9.15.0"
  }
}
