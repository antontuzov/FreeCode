{
  "name": "smollm-studio",
  "private": true,
  "version": "0.1.0",
  "description": "SmoLLM Studio monorepo \u2014 local-first desktop coding agent for Ternary Bonsai 2 27B",
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "dev": "pnpm --filter @smollm/desktop dev",
    "build": "pnpm --filter @smollm/desktop build",
    "typecheck": "pnpm --filter @smollm/desktop typecheck",
    "lint": "pnpm --filter @smollm/desktop lint",
    "tauri": "pnpm --filter @smollm/desktop tauri",
    "app:dev": "pnpm --filter @smollm/desktop tauri dev",
    "app:dev:fixture": "pnpm --filter @smollm/desktop tauri:fixture",
    "app:dev:settings": "pnpm --filter @smollm/desktop tauri:settings",
    "app:dev:chat": "pnpm --filter @smollm/desktop tauri:chat",
    "app:build": "pnpm --filter @smollm/desktop tauri build",
    "format": "pnpm --filter @smollm/desktop format",
    "format:check": "pnpm --filter @smollm/desktop format:check",
    "verify:catalog": "./scripts/verify-catalog.sh",
    "verify:ui": "./scripts/verify-tauri-ui.sh",
    "verify:precommit": "./scripts/verify-precommit.sh",
    "verify:desktop": "./scripts/verify-desktop-native.sh",
    "verify:all": "./scripts/verify-studio-natively.sh",
    "icon": "pnpm --filter @smollm/desktop tauri icon src-tauri/icons/source.png"
  }
}
