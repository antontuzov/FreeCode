{
  "name": "freecode",
  "private": true,
  "version": "0.1.0",
  "description": "FreeCode monorepo — local-first desktop chat with a free-model tier and Ternary Bonsai on your machine",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "pnpm --filter @freecode/desktop dev",
    "build": "pnpm --filter @freecode/desktop build",
    "typecheck": "pnpm --filter @freecode/desktop typecheck",
    "test": "pnpm --filter @freecode/desktop test",
    "lint": "pnpm --filter @freecode/desktop lint",
    "tauri": "pnpm --filter @freecode/desktop tauri",
    "app:dev": "pnpm --filter @freecode/desktop tauri dev",
    "app:dev:fixture": "pnpm --filter @freecode/desktop tauri:fixture",
    "app:dev:settings": "pnpm --filter @freecode/desktop tauri:settings",
    "app:dev:chat": "pnpm --filter @freecode/desktop tauri:chat",
    "app:build": "pnpm --filter @freecode/desktop tauri build",
    "format": "pnpm --filter @freecode/desktop format",
    "format:check": "pnpm --filter @freecode/desktop format:check",
    "verify:catalog": "./scripts/verify-catalog.sh",
    "verify:ui": "./scripts/verify-tauri-ui.sh",
    "verify:precommit": "./scripts/verify-precommit.sh",
    "verify:desktop": "./scripts/verify-desktop-native.sh",
    "verify:all": "./scripts/verify-studio-natively.sh",
    "icon": "pnpm --filter @freecode/desktop tauri icon src-tauri/icons/source.png"
  }
}
